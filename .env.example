# Copy this file to .env (gitignored) and fill in your key.
#
#   cp .env.example .env
#   $EDITOR .env
#
# Then either:
#   set -a; source .env; set +a    # POSIX shells
# or use direnv / a pre-run wrapper that loads it.

# Only needed for `scripts/run_agent.py --backend anthropic`, or to give Kilo
# your own Anthropic key (Claude Code signs in separately). Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=sk-ant-replace-me
