# Site defaults for `setup.sh --hpc` on FSU RCC. Sourced by setup.sh; an
# AOF_OPENFOAM_SIF already set in your environment wins.
#
# The portable OpenFOAM v2412 image, built once by the instructor with
#   scripts/build-openfoam-sif.sh <dir>
# and shared read-only with the class.
: "${AOF_OPENFOAM_SIF:=/gpfs/research/engineering/dk26/agentic-openfoam-shared/openfoam-v2412.sif}"
# Off-cluster copy (e.g. a GitHub release asset) — used when the path above
# is not visible. Leave empty to fall back to building the image.
: "${AOF_OPENFOAM_SIF_URL:=}"
