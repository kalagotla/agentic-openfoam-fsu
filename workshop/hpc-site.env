# Site defaults for `setup.sh --hpc` on FSU RCC. Sourced by setup.sh and
# scripts/local-model.sh; a value already set in your environment wins.
#
# The class-wide shared install, staged once by the instructor with
#   scripts/stage-hpc-shared.sh <dir>
# and read-only for everyone else. Attendees symlink to it instead of
# downloading ~15 GB each. Each piece is looked up in the workshop's
# seminar space first, then in the instructor's copy.
_aof_shared_dirs=(
    /gpfs/research/engineering/engineering_seminar/2026_10_02/agentic-openfoam-shared
    /gpfs/research/engineering/dk26/agentic-openfoam-shared
)
_aof_pick() {   # first shared dir that has $1
    local d
    for d in "${_aof_shared_dirs[@]}"; do [[ -e $d/$1 ]] && { echo "$d/$1"; return; }; done
    echo "${_aof_shared_dirs[-1]}/$1"
}
# Portable OpenFOAM v2412 image.
: "${AOF_OPENFOAM_SIF:=$(_aof_pick openfoam-v2412.sif)}"
# Off-cluster copy (e.g. a GitHub release asset) — used when the path above
# is not visible. Leave empty to fall back to building the image.
: "${AOF_OPENFOAM_SIF_URL:=https://github.com/kalagotla/agentic-openfoam-fsu/releases/download/openfoam-v2412-sif/openfoam-v2412.sif}"
# Ollama release (bin/ollama + GPU runtimes) and pre-pulled model weights.
# Missing paths are ignored: setup.sh then downloads as usual.
: "${AOF_OLLAMA_SHARED:=$(_aof_pick ollama)}"
: "${AOF_OLLAMA_MODELS_SHARED:=$(_aof_pick ollama-models)}"
# The GPU job scripts/hpc-gpu.sh queues (needs an account with GPU access).
: "${AOF_GPU_SBATCH:=-p gpu_q -A gpu_q --gres=gpu:1 -c 4 --mem=32G -t 4:00:00}"
