{
  "mcpServers": {
    "openfoam": {
      "command": "scripts/with-openfoam.sh",
      "args": [
        "uv",
        "run",
        "--package",
        "openfoam-mcp",
        "python",
        "-m",
        "openfoam_mcp"
      ]
    },
    "validation": {
      "command": "uv",
      "args": [
        "run",
        "--package",
        "validation-mcp",
        "python",
        "-m",
        "validation_mcp"
      ]
    },
    "consultant": {
      "command": "uv",
      "args": [
        "run",
        "--package",
        "consultant-mcp",
        "python",
        "-m",
        "consultant_mcp"
      ]
    },
    "research_assistant": {
      "command": "scripts/with-openfoam.sh",
      "args": [
        "uv",
        "run",
        "--package",
        "research-assistant-mcp",
        "python",
        "-m",
        "research_assistant_mcp"
      ]
    }
  }
}
