# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# uv
.uv-cache/

# OpenFOAM run artifacts — keep case structure and dict files, ignore time dirs & logs.
# Time directories are numeric: 1, 1.5, 100, 200, ... but NOT 0/ which holds the
# committed initial conditions, so the leading-digit pattern starts at [1-9].
cases/**/baseline/[1-9]*/
cases/**/baseline/processor*/
cases/**/baseline/postProcessing/
cases/**/baseline/log.*
cases/**/baseline/*.foam
# constant/polyMesh is generated by blockMesh on every run.
cases/**/baseline/constant/polyMesh/
cases/**/runs/
cases/**/*.vtk

# Local-only planning artifacts.
docs/build-plan.md
docs/runsheet.md
docs/slide-outline.md

# Local-only demo notes and run artifacts.
demos/

# Claude Code per-user / per-machine state.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/cache/
.claude/history.jsonl
.claude/sessions/
.claude/projects/

# Draft corpus annotations produced by
# consultant.draft_annotation_from_report — staging area for human review,
# not corpus content. Promote into the corpus by renaming `.draft.md` -> `.md`.
corpus/**/*.draft.md

# Agent-authored cases (cases/work/<name>/) are throwaway scratch space.
cases/work/

# wmake build artifacts under custom-code examples — sources are tracked,
# compiled outputs are not.
cases/examples/custom-bc-example/test-case/[1-9]*/
cases/examples/custom-bc-example/test-case/log.*
cases/examples/custom-bc-example/test-case/constant/polyMesh/
cases/**/lib/Make/linux*/
cases/**/lib/lnInclude/

# ParaView
*.pvd
*.pvsm

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets — defense in depth
.env
.env.*
!.env.example

# Large binaries / media
*.mp4
*.mov
*.png
*.jpg
!docs/**/*.png
!docs/**/*.jpg

# surfaceCheck writes diagnostic files to the CWD. They are typically
# zero-length when the surface is clean and serve no archival purpose.
badFaces
illegalFaces
*_normal_*.obj
*.vtp

# Evaluation runs: one directory per run (case, logs, record.json). Only the
# aggregated tables are committed, never the raw matrix output.
scripts/eval/results/

# Per-machine local-model choice, written by scripts/local-model.sh.
.kilo/kilo.jsonc
.local-model
setup.log

# HPC: Apptainer image + build cache (setup.sh --hpc).
.hpc/
.doctor.*/
